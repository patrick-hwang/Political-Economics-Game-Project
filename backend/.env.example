# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored — never commit your actual key.
#
# How to get a key: https://aistudio.google.com/  -> "Get API key" -> "Create API key"

# Google AI Studio API key (required for AI explanations).
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (reads directly from here)
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback model if the primary model is unavailable or rate-limited
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
